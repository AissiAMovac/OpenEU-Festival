    var min=Math.min.apply(null,ss.map(function(s){return new Date(s.s).getTime();}));
    var max=Math.max.apply(null,ss.map(function(s){return new Date(s.e).getTime();}));
    return {min:min,max:max};
  }

  var MOBILE_BP=760;
  var DAY_LABELS={fri:'Friday 23',sat:'Saturday 24',sun:'Sunday 25'};
  var DAY_ORDER=['fri','sat','sun'];
  function render(){
    gridEl.innerHTML='';
    if(isFiltering()){
      // a track or topic filter is active: flat cross-day results, grouped under a day
      // heading so it's always clear which day each matching talk is on — a proportional
      // time grid doesn't make sense once results span three different days' timelines
      renderCrossDayResults(SESSIONS.filter(matches));
      return;
    }
    var bounds=dayBounds(state.day);
    if(!bounds)return;
    var list=SESSIONS.filter(matches);
    if(window.innerWidth<=MOBILE_BP){renderMobileFeed(list);}
    else{renderDesktopGrid(list,bounds);}
  }

  function renderCrossDayResults(list){
    var feed=document.createElement('div');feed.className='agmobilefeed';
    if(!list.length){
      var empty=document.createElement('div');empty.className='agemptyday agemptyday-flow';
      empty.textContent='No sessions match this topic.';
      feed.appendChild(empty);
      gridEl.appendChild(feed);
      return;
    }
    var sorted=list.slice().sort(function(a,b){
      var da=DAY_ORDER.indexOf(a.day), db=DAY_ORDER.indexOf(b.day);
      if(da!==db)return da-db;
      var d=new Date(a.s)-new Date(b.s);
      if(d)return d;
      return (a.room||'').localeCompare(b.room||'',undefined,{numeric:true});
    });
    var curDay=null;
    sorted.forEach(function(s){
      if(s.day!==curDay){
        curDay=s.day;
        var hd=document.createElement('div');hd.className='agdaysep';
        hd.textContent=DAY_LABELS[curDay]||curDay;
        feed.appendChild(hd);
      }
      var card=s.kind==='breakout'?brkBlock(s,(TRACKS[s.track]||{}).c):featBlock(s);
      card.classList.add('agcard-flow');
      feed.appendChild(card);
    });
    gridEl.appendChild(feed);
  }

  // ---- Mobile: a clean chronological stacked list. Same card styling and
  // colors as desktop, but no side-by-side columns — those only work with
  // room to breathe. Parallel sessions just follow each other in order,
  // each full width, distinguished by their own room/track label.
  function renderMobileFeed(list){
    var feed=document.createElement('div');feed.className='agmobilefeed';
    var visibleCount=list.filter(function(x){return x.kind!=='break';}).length;
    if(!visibleCount){
      var empty=document.createElement('div');empty.className='agemptyday agemptyday-flow';
      empty.textContent='No sessions match these filters on this day.';
      feed.appendChild(empty);
      gridEl.appendChild(feed);
      return;
    }
    var sorted=list.slice().sort(function(a,b){
      var d=new Date(a.s)-new Date(b.s);
      if(d)return d;
      return (a.room||'').localeCompare(b.room||'',undefined,{numeric:true});
    });
    sorted.forEach(function(s){
      if(s.kind==='break'){
        var band=document.createElement('div');band.className='agbreakband agbreakband-flow';
        band.innerHTML='<span>'+esc(s.title)+' · '+fmtTime(s.s,curTz())+'–'+fmtTime(s.e,curTz())+'</span>';
        feed.appendChild(band);
        return;
      }
      var card=s.kind==='breakout'?brkBlock(s,(TRACKS[s.track]||{}).c):featBlock(s);
      card.classList.add('agcard-flow');
      feed.appendChild(card);
    });
    gridEl.appendChild(feed);
  }

  // ---- Desktop/tablet: the full proportional time-grid with side-by-side
  // room columns, dotted gridlines, and the diffused background wash.
  function renderDesktopGrid(list,bounds){
    var lanes=laneRoomsForDay(state.day); // null => single implicit column
    var nLanes=lanes?lanes.length:1;

    var startTick=Math.floor(bounds.min/TICK_MS)*TICK_MS;
    var endTick=Math.ceil(bounds.max/TICK_MS)*TICK_MS;
    var yMap=buildYMap(state.day,startTick,endTick);
    var totalH=Math.max(yMap.totalH,80);

    var containerW=(gridEl.clientWidth||gridEl.parentElement.clientWidth||900);
    var axisGuess=54;
    var avail=Math.max(containerW-axisGuess-4,200);
    var minLaneW=130, maxLaneW=lanes?230:480;
    var laneW=lanes?Math.max(minLaneW,Math.min(maxLaneW,Math.floor(avail/nLanes))):Math.max(minLaneW,Math.min(maxLaneW,avail));
    var totalLaneWidth=nLanes*laneW;

    var scrollWrap=document.createElement('div');scrollWrap.className='agtimelinescroll';
    var inner=document.createElement('div');inner.className='agtimelineinner';
    if(lanes){
      var hdr=document.createElement('div');hdr.className='agcolheaders';
      lanes.forEach(function(r){var h=document.createElement('div');h.className='agcolhead';h.style.width=(laneW-6)+'px';h.textContent=r;hdr.appendChild(h);});
      inner.appendChild(hdr);
    }

    var timeline=document.createElement('div');timeline.className='agtimeline';
    var axis=document.createElement('div');axis.className='agaxis';axis.style.height=totalH+'px';
    var laneArea=document.createElement('div');laneArea.className='aglanearea';laneArea.style.height=totalH+'px';laneArea.style.minWidth=totalLaneWidth+'px';

    var PASTELS=['#CBE5F6','#FCC5E2','#D6C5FC','#C2FFDB','#FBE7A1','#FAD4D0'];
    if(lanes){
      lanes.forEach(function(r,i){
        var bg=document.createElement('div');bg.className='agcolbg';
        bg.style.left=(i*laneW)+'px';bg.style.width=laneW+'px';
        bg.style.background=PASTELS[i%PASTELS.length];
        laneArea.appendChild(bg);
      });
    } else {
      // single-lane days (e.g. Friday): the lane area still stretches to fill the
      // page width, so spread a few blobs across it by percentage, not just the
      // narrow card column, so the void doesn't stay bare white.
      var spread=['#CBE5F6','#FCC5E2','#D6C5FC','#C2FFDB'];
      spread.forEach(function(c,i){
        var bg=document.createElement('div');bg.className='agcolbg';
        bg.style.left=(i*28)+'%';bg.style.width='45%';
        bg.style.background=c;
        laneArea.appendChild(bg);
      });
    }

    var LABEL_MS=30*60000, LINE_MS=15*60000;
    for(var t=startTick;t<=endTick;t+=LINE_MS){
      var top=yMap.yPos(t);
      var tl=document.createElement('div');tl.className='agtickline';tl.style.top=top+'px';laneArea.appendChild(tl);
      if((t-startTick)%LABEL_MS===0){
        var lbl=document.createElement('div');lbl.className='agticklabel';lbl.style.top=(top-7)+'px';
        lbl.textContent=fmtTime(new Date(t).toISOString(),curTz());axis.appendChild(lbl);
      }
    }

    var visibleCount=list.filter(function(x){return x.kind!=='break';}).length;
    if(!visibleCount){
      var empty=document.createElement('div');empty.className='agemptyday';
      empty.textContent='No sessions match these filters on this day.';
      laneArea.appendChild(empty);
    }

    var VGAP=9;
    list.forEach(function(s){
      var sMs=new Date(s.s).getTime(), eMs=new Date(s.e).getTime();
      var top=yMap.yPos(sMs), h=yMap.yPos(eMs)-top;
      if(s.kind==='break'){
        var band=document.createElement('div');band.className='agbreakband';
        band.style.top=(top+VGAP/2)+'px';band.style.height=Math.max(h-VGAP,13)+'px';
        band.innerHTML='<span>'+esc(s.title)+' · '+fmtTime(s.s,curTz())+'–'+fmtTime(s.e,curTz())+'</span>';
        laneArea.appendChild(band);
        return;
      }
      // Any Plenary-room session must always span the full width, regardless of kind —
      // previously only entertainment/meal/opening did, so keynotes/conversations/talks
      // in the Plenary got squeezed into the narrow first breakout-room column on days
      // that also have breakout rooms (e.g. Saturday), clipping their titles.
      var isWide=(s.room==='Plenary')||(s.kind==='entertainment'||s.kind==='meal'||s.kind==='opening');
      var card, laneIdx=(lanes&&s.kind==='breakout')?lanes.indexOf(s.room):0;
      if(laneIdx<0)laneIdx=0;
      card=s.kind==='breakout'?brkBlock(s,(TRACKS[s.track]||{}).c):featBlock(s);
      if(isWide){
        card.style.left='5px';
        card.style.width=(totalLaneWidth-10)+'px';
      } else {
        card.style.left=(laneIdx*laneW+5)+'px';
        card.style.width=(laneW-10)+'px';
      }
      card.style.top=(top+VGAP/2)+'px';
      card.style.height=Math.max(h-VGAP,40)+'px';
      laneArea.appendChild(card);
    });

    timeline.appendChild(axis);
    timeline.appendChild(laneArea);
    inner.appendChild(timeline);
    scrollWrap.appendChild(inner);
    gridEl.appendChild(scrollWrap);
  }

  // Keeps the day tabs' highlighted state truthful: a day tab is only "on" when
  // neither a track nor a topic filter is active (since those now search all 3 days).
  function syncDayTabs(){
    [].forEach.call(daysEl.children,function(c){c.classList.toggle('on', !isFiltering() && c.dataset.day===state.day);});
  }

  function attachToggle(btn,body){
    btn.addEventListener('click',function(){
      var open=body.classList.toggle('open');
      btn.classList.toggle('open',open);
      btn.setAttribute('aria-expanded',open?'true':'false');
    });
  }
  attachToggle(trackToggleEl,trackPillsEl);
  attachToggle(pillsToggleEl,pillsEl);

  daysEl.addEventListener('click',function(e){
    var b=e.target.closest('.agday');if(!b)return;
    state.day=b.dataset.day;
    state.track='all'; state.topic='all'; // picking a day returns to normal per-day browsing
    [].forEach.call(trackPillsEl.querySelectorAll('.agpill'),function(c){c.classList.toggle('on',c.dataset.track==='all');});
    [].forEach.call(pillsEl.querySelectorAll('.agpill'),function(c){c.classList.toggle('on',c.dataset.topic==='all');});
    syncDayTabs();
    render();
  });
  var resizeTimer;
  window.addEventListener('resize',function(){clearTimeout(resizeTimer);resizeTimer=setTimeout(render,150);});
  // Track and Topic are separate, mutually exclusive filters — picking a track clears
  // any active topic (and vice versa) so they never silently combine into an AND search.
  trackPillsEl.addEventListener('click',function(e){
    var b=e.target.closest('.agpill');if(!b)return;
    state.track=b.dataset.track;
    [].forEach.call(trackPillsEl.querySelectorAll('.agpill'),function(c){c.classList.toggle('on',c===b);});
    if(state.track!=='all'){
      state.topic='all';
      [].forEach.call(pillsEl.querySelectorAll('.agpill'),function(c){c.classList.toggle('on',c.dataset.topic==='all');});
    }
    syncDayTabs();
    render();
  });
  pillsEl.addEventListener('click',function(e){
    var b=e.target.closest('.agpill');if(!b)return;
    state.topic=b.dataset.topic;
    [].forEach.call(pillsEl.querySelectorAll('.agpill'),function(c){c.classList.toggle('on',c===b);});
    if(state.topic!=='all'){
      state.track='all';
      [].forEach.call(trackPillsEl.querySelectorAll('.agpill'),function(c){c.classList.toggle('on',c.dataset.track==='all');});
    }
    syncDayTabs();
    render();
  });
  tzEl.addEventListener('change',function(){state.tzKey=this.value;render();});
  searchEl.addEventListener('input',function(){state.search=this.value;searchClearEl.classList.toggle('show',!!this.value);render();});
  searchClearEl.addEventListener('click',function(){searchEl.value='';state.search='';searchClearEl.classList.remove('show');render();searchEl.focus();});
  $('agPdf').addEventListener('click',function(e){/* placeholder: replace href with real PDF URL when available */ if(this.getAttribute('href')==='#'){e.preventDefault();alert('The downloadable PDF programme will be linked here. Replace the agPdf href with your PDF URL.');}});
  render();
})();
</script>
</div>
